# Copia a .env y ajusta. NO commitear .env con valores reales.

# PostgreSQL
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tender
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (almacenamiento de objetos S3-compatible)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Cadena de conexión que consumen los servicios (tender-api, etc.)
# (psycopg v3). Ajusta host a 'localhost' fuera de Docker o al nombre del servicio dentro.
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tender
